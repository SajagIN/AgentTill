# AgentTill — environment (Bun auto-loads .env; never commit the real .env)
# Get keys: Razorpay Dashboard → Settings → API Keys (Test mode)

# Required NOW (Phase 0)
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Required from Phase 3 (Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Required from Phase 6
OPENAI_API_KEY=openai-key
OPENAI_MODEL=gpt-4o-mini

# Server
PORT=3000
BASE_URL=http://localhost:3000
